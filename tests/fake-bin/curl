#!/usr/bin/env python3
"""Fake `curl` for the smoke.sh tests.

$FAKE_SCENARIO's "curl" list holds rules {"url": substring, "header":
optional substring of a -H value, "direct": optional bool (true = only
requests with --resolve, i.e. straight to the origin; false = only without),
"code": "200", "body": "..."}; the first match answers. No match behaves like a refused connection (code 000, exit 7).
Calls are logged to $FAKE_LOG like the fake docker.
"""
import json
import os
import sys


def main(argv):
    with open(os.environ["FAKE_SCENARIO"]) as f:
        rules = json.load(f).get("curl", [])
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write(json.dumps(["curl"] + argv) + "\n")

    url = next(a for a in argv if a.startswith("http"))
    headers = [argv[i + 1] for i, a in enumerate(argv) if a == "-H"]
    write_code = "-w" in argv
    discard_body = "/dev/null" in argv

    for rule in rules:
        if rule["url"] not in url:
            continue
        if "header" in rule and not any(rule["header"] in h for h in headers):
            continue
        if "direct" in rule and rule["direct"] != ("--resolve" in argv):
            continue
        if not discard_body:
            sys.stdout.write(rule.get("body", ""))
        if write_code:
            sys.stdout.write(rule["code"])
        return 0

    if write_code:
        sys.stdout.write("000")
    return 7


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
