#!/usr/bin/env python3
"""Fake `docker` for the script tests.

Behaviour comes from the JSON scenario file named by $FAKE_SCENARIO; every
call is appended to $FAKE_LOG as one JSON array per line. Only the commands
the scripts actually run are understood; anything else fails loudly so a new
call cannot pass a test by accident.
"""
import json
import os
import sys


def main(argv):
    with open(os.environ["FAKE_SCENARIO"]) as f:
        scenario = json.load(f)
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write(json.dumps(argv) + "\n")

    joined = " ".join(argv)
    for needle in scenario.get("fail_on", []):
        if needle in joined:
            print(f"fake docker: failing on {needle!r}", file=sys.stderr)
            return 1

    # `docker compose --project-directory D -f F <sub...>` -> ["compose", sub...]
    if argv[:1] == ["compose"]:
        rest = argv[1:]
        while rest and rest[0] in ("--project-directory", "-f"):
            rest = rest[2:]
        return compose(scenario, rest)

    cmd, args = argv[0], argv[1:]
    if cmd == "run" and "tar" in args:
        sys.stdout.write(scenario.get("instances_tgz", "TGZ-fake"))
        return 0
    if cmd == "inspect":
        return lookup(scenario.get("inspect", {}), args[-1])
    if cmd == "network" and args[0] == "ls":
        print("\n".join(scenario.get("networks", {})))
        return 0
    if cmd == "network" and args[0] == "inspect":
        return network_inspect(scenario, args[2], args[3:])
    if cmd == "network" and args[0] == "create":
        return 0
    if cmd == "port":
        print(scenario.get("port", ""))
        return 0
    if cmd == "exec" and "reload" in args:
        return scenario.get("reload_rc", 0)
    if cmd == "exec" and "list-modules" in args:
        print(scenario.get("modules", "http.handlers.reverse_proxy\ndns.providers.cloudflare"))
        return 0
    if cmd == "logs":
        return nginx_logs(scenario)
    print(f"fake docker: unexpected call {argv}", file=sys.stderr)
    return 99


def compose(scenario, rest):
    if rest[:3] == ["exec", "-T", "postgres"]:
        sys.stdout.write(scenario.get("pg_dump", "PGDMP-fake"))
        return 0
    if rest[:3] == ["exec", "-T", "redis"]:
        return 0
    if rest[:1] == ["cp"]:
        with open(rest[2], "w") as f:
            f.write(scenario.get("rdb", "REDIS-fake"))
        return 0
    if rest[:2] == ["ps", "-q"]:
        print(scenario.get("ids", {}).get(rest[2], ""))
        return 0
    if rest[:2] == ["up", "-d"]:
        return 0
    print(f"fake docker compose: unexpected call {rest}", file=sys.stderr)
    return 99


def network_inspect(scenario, fmt, names):
    """baja-edge: "edge_subnet" (absent = no such network) for a Subnet
    format, "network" (member names) for a Containers format. Any other
    network: one "<name> <subnets>" line from the "networks" table."""
    if names == ["baja-edge"]:
        key = "edge_subnet" if "Subnet" in fmt else "network"
        if key not in scenario:
            return 1
        print(scenario[key])
        return 0
    for name in names:
        print(f"{name} {scenario['networks'][name]}")
    return 0


def nginx_logs(scenario):
    """One combined-format line for the last marked smoke request curl saw,
    from client "nginx_log_addr" (absent = the request never arrived)."""
    if "nginx_log_addr" not in scenario:
        return 0
    with open(os.environ["FAKE_LOG"]) as f:
        urls = [a for line in f for a in json.loads(line) if "baja-smoke=" in a]
    if urls:
        path = "/" + urls[-1].split("/", 3)[3]
        print(f'{scenario["nginx_log_addr"]} - - [28/Oct/2026:03:00:00 +0000] "GET {path} HTTP/1.1" 200 5 "-" "curl/8"')
    return 0


def lookup(table, key):
    if key not in table:
        return 1
    print(table[key])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
