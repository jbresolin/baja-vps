# Caddy config for the Baja staging VPS (base stack).
#
# This file holds only:
#   - global options (ACME e-mail, which proxies may set the client IP),
#   - shared snippets for conf.d files,
#   - ONE site: Evolution API + Manager, tailnet only.
# Every public site comes from /srv/caddy/conf.d/*.caddy, one file per stack
# (README §6). This repo installs conf.d/staging.caddy from there.
#
# {$VAR} placeholders come from the container environment (docker-compose.yml,
# caddy/cloudflare-ips.env, the optional caddy.env) and are substituted when
# Caddy loads the config.
# Reload after editing this file or any conf.d file:
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile

# -----------------------------------------------------------------------------
# Global options
# -----------------------------------------------------------------------------
{
	# Let's Encrypt account e-mail (expiry notices).
	email {$ACME_EMAIL}
	# The admin API stays on localhost:2019 INSIDE the container (default).
	# It is not published; `caddy reload` and the healthcheck use it.

	# No acme_dns here: DNS-01 is set per site, on the Cloudflare-proxied
	# staging vhosts only (conf.d/staging.caddy). Every other site, e.g. the
	# pipeline's grey-cloud hostname, keeps the default HTTP-01/TLS-ALPN.

	servers {
		# Cloudflare proxies the staging domains (README §5.3). For requests
		# that arrive FROM a Cloudflare range, Caddy takes the client IP from
		# CF-Connecting-IP; from anywhere else, the TCP peer is the client and
		# any CF-Connecting-IP it sent is ignored. Either way {client_ip} is
		# the real client, for access logs and for upstreams.
		#
		# This is per listener, so it covers every site on :443, not only
		# staging. Harmless for grey-cloud sites: their visitors are never
		# Cloudflare addresses, so it never applies to them.
		#
		# {$CLOUDFLARE_IPS} comes from caddy/cloudflare-ips.env, the same list
		# staging.caddy's remote_ip gate uses (README §5.3).
		trusted_proxies static {$CLOUDFLARE_IPS}
		client_ip_headers CF-Connecting-IP
	}
}

# -----------------------------------------------------------------------------
# Shared snippets. Defined before the import, so conf.d files can use them.
# Snippet names are global: conf.d files should prefix their own.
# -----------------------------------------------------------------------------

# Request log to stdout (rotated by the Docker json-file driver).
(access_log) {
	log {
		output stdout
		format console
	}
}

# -----------------------------------------------------------------------------
# Plug-in sites: one file per stack. No match is only a warning, so Caddy
# starts with an empty conf.d.
# -----------------------------------------------------------------------------
import /srv/caddy/conf.d/*.caddy

# -----------------------------------------------------------------------------
# Evolution API + Manager UI: tailnet ONLY.
#    Plain HTTP: the tailnet is the network boundary and WireGuard already
#    encrypts (same model as the pipeline's worker API). Docker publishes
#    container port 8081 only on the host's Tailscale IP, so there is no
#    public route to Evolution at all. Inside the container Caddy listens on
#    every interface; the Tailscale address is not visible in here, which is
#    why the binding lives on the `ports:` entry, not in a `bind` directive.
#    Consumers on the server (the orchestrator) call http://evolution:8080
#    over baja-edge and never come through here.
#    The Manager UI is the API's own bundled UI at /manager (+ /assets/*).
# -----------------------------------------------------------------------------
http://:8081 {
	import access_log

	# Manager UI and its static assets: behind HTTP basic auth, in front of
	# Evolution's own API-key login. The browser then sends the API key on
	# its XHR calls, which go through the API block below.
	@manager path /manager /manager/* /assets/*
	handle @manager {
		basic_auth {
			{$MANAGER_BASIC_AUTH_USER} {$MANAGER_BASIC_AUTH_HASH}
		}
		reverse_proxy evolution:8080
	}

	# API: reject any request without an `apikey` header at the edge.
	# Evolution still validates the key's value. (`!Field` = header absent.)
	@no_apikey header !apikey
	handle @no_apikey {
		respond "Missing apikey header" 401
	}

	# Everything else (with an apikey header) goes to the API.
	handle {
		reverse_proxy evolution:8080
	}
}
