# Baja staging VPS base stack: environment for docker-compose.yml, setup.sh,
# backup.sh and smoke.sh.
# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
#
# Quoting: wrap any value containing `$` (bcrypt hashes) or spaces in SINGLE
# quotes. Docker Compose treats single-quoted values literally, and the
# scripts load this file into bash (`set -a; . ./.env; set +a`).
# Keep comments on their own line, never after a value.
# Secrets: generate with `openssl rand -hex 24` (hex = URL-safe, so it can
# go straight into DATABASE_CONNECTION_URI).
#
# Values marked [MATCH TRUENAS] must be copied from the running TrueNAS
# Evolution container (README §4.1). Any other value breaks the migrated session.

# -----------------------------------------------------------------------------
# Network and TLS (Caddy)
# -----------------------------------------------------------------------------
# The VPS's Tailscale IPv4 (`tailscale ip -4`). Caddy publishes the Evolution
# listener (8081) and the pipeline's worker listener (8080) ONLY on this address.
TAILSCALE_IP=100.64.0.1
# Let's Encrypt account e-mail.
ACME_EMAIL=you@example.org
# (No subnet setting: setup.sh always creates `baja-edge` as 10.201.0.0/24,
# because all three stacks trust that exact range. README §2.3.)

# Manager UI basic auth (in front of Evolution's own API-key login).
# Hash: docker run --rm caddy:2.11.7-alpine caddy hash-password --plaintext 'the-password'
MANAGER_BASIC_AUTH_USER=baja
MANAGER_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT'

# -----------------------------------------------------------------------------
# Scoring staging vhosts (conf.d/staging.caddy). Same values as BAJA_DOMAIN
# and FORMULA_DOMAIN in the staging stack's baja-infra/.env.
# Needed only once `./setup.sh --enable-staging` has been run.
# -----------------------------------------------------------------------------
# Registrable domain: the apex plus www. api. certificado. fila. juiz.
# resultados. forum.
BAJA_DOMAIN=bajasaebrasil.com.br
# The Formula forum's WHOLE hostname (not a subdomain label).
FORMULA_DOMAIN=forum.formula.example.org
# Cloudflare API token for the DNS-01 challenge on those hostnames (they are
# Cloudflare-proxied, so HTTP-01 is unreliable). Create it under My Profile >
# API Tokens > Custom token with exactly:
#   Zone / DNS / Edit  and  Zone / Zone / Read
# restricted to the two zones (BAJA_DOMAIN's and FORMULA_DOMAIN's). README §5.3.
CLOUDFLARE_API_TOKEN=REPLACE_ME

# -----------------------------------------------------------------------------
# Evolution API
# -----------------------------------------------------------------------------
# Global API key (header `apikey`). [MATCH TRUENAS] for the cutover, so
# nothing that already holds it breaks. Rotate later if you like (README §12).
EVOLUTION_API_KEY=REPLACE_ME
# [MATCH TRUENAS] DATABASE_CONNECTION_CLIENT_NAME. Instances whose
# "clientName" differs are silently NOT loaded.
EVOLUTION_CLIENT_NAME=evolution_exchange
# [MATCH TRUENAS] the `?schema=` part of TrueNAS's DATABASE_CONNECTION_URI
# (upstream example: evolution_api, some installs use public).
EVOLUTION_DB_SCHEMA=evolution_api
# [MATCH TRUENAS] the DB index at the end of CACHE_REDIS_URI (redis://host:6379/<N>).
EVOLUTION_REDIS_DB=6
# [MATCH TRUENAS] CACHE_REDIS_PREFIX_KEY (code default is `evolution-cache`
# if unset, the upstream .env.example sets `evolution`).
EVOLUTION_REDIS_PREFIX=evolution
# [MATCH TRUENAS] CACHE_REDIS_SAVE_INSTANCES (default false).
EVOLUTION_REDIS_SAVE_INSTANCES=false
# Shown on the phone under Linked devices. Keep the TrueNAS values.
EVOLUTION_PHONE_CLIENT='Evolution API'
EVOLUTION_PHONE_NAME=Chrome
# What Evolution stores in Postgres. The pipeline reads nothing back from
# it, so these modest defaults are fine.
EVOLUTION_SAVE_NEW_MESSAGE=true
EVOLUTION_SAVE_MESSAGE_UPDATE=false
EVOLUTION_SAVE_CONTACTS=true
EVOLUTION_SAVE_CHATS=true
EVOLUTION_SAVE_LABELS=false
EVOLUTION_SAVE_HISTORIC=false
# Instance name of the Baja Bot account, exactly as on TrueNAS (README §4.1).
# Only the runbook and smoke.sh use it (connection state must be `open`).
EVOLUTION_INSTANCE=REPLACE_WITH_TRUENAS_INSTANCE_NAME

# Postgres for Evolution. A new password is fine. The dump restores data,
# not roles. DB name/user can differ from TrueNAS (restore uses --no-owner).
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=REPLACE_ME_HEX

# -----------------------------------------------------------------------------
# Backups (backup.sh, run daily by systemd/baja-evolution-backup.timer)
# -----------------------------------------------------------------------------
# Where the dumps go. They contain the WhatsApp private keys: root-only.
BACKUP_DIR=/var/backups/baja-evolution
# Backups older than this many days are deleted after each successful run.
BACKUP_KEEP_DAYS=14
